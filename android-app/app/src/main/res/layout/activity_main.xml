<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Preview + overlay 保持 4:3 显示 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        app:scaleType="fitCenter"
    app:layout_constraintTop_toBottomOf="@id/header_card"
    app:layout_constraintBottom_toTopOf="@id/bottom_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.bohuyeshan.buckwheat.ui.DetectionOverlayView
        android:id="@+id/detection_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
    app:layout_constraintTop_toBottomOf="@id/header_card"
    app:layout_constraintBottom_toTopOf="@id/bottom_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top card: status and actions -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:padding="0dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_initializing"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                    android:textColor="@color/onBackground" />

                <TextView
                    android:id="@+id/mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/mode_realtime"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:textColor="@color/onBackgroundSecondary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/provider_chip"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checkable="false"
                    android:text="@string/provider_accel"
                    app:chipIcon="@drawable/ic_performance"
                    app:chipIconTint="@color/controlIcon"
                    app:chipStrokeColor="@color/controlIcon"
                    app:chipStrokeWidth="0.5dp" />
            </LinearLayout>

                <com.google.android.material.button.MaterialButton
                android:id="@+id/button_photo_manager"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text=""
                android:contentDescription="@string/photo_manager"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:iconTint="@color/controlIcon" />

                <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text=""
                android:contentDescription="@string/settings"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconTint="@color/controlIcon" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Performance Monitor Panel -->
    <LinearLayout
        android:id="@+id/performance_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="8dp"
        android:layout_margin="8dp"
        android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/header_card"
        app:layout_constraintEnd_toEndOf="parent">

                <TextView
            android:id="@+id/perf_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS: --"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/perf_cpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU: --%"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/perf_memory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEM: -- MB"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/perf_gpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU: N/A"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/perf_npu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NPU: N/A"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Bottom control card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mode_toggle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="12dp"
                android:text=""
                android:contentDescription="@string/mode"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_mode"
                app:iconGravity="textStart"
                app:iconTint="@color/controlIcon" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/button_shutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/shutter"
                android:elevation="8dp"
                android:background="@drawable/fab_shutter_bg"
                app:srcCompat="@drawable/ic_shutter"
                app:useCompatPadding="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkbox_emoji"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="12dp"
                android:text=""
                android:contentDescription="@string/emoji"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_emoji"
                app:iconGravity="textStart"
                app:iconTint="@color/controlIcon" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
